# Hailing LocalStage environment (spec §54). Copy to .env — never commit .env.
# SQLite LocalStage (no docker needed):
DATABASE_URL="file:./dev.db"
# Postgres LocalStage (docker compose):
# DATABASE_URL="postgresql://hailing:hailing@localhost:5432/hailing"
REDIS_URL="redis://localhost:6379"
RABBITMQ_URL="amqp://hailing:hailing@localhost:5672"
PORT=3001
WORKER_HEARTBEAT_MS=30000
