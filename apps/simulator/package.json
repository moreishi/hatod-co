{
  "name": "@hailing/simulator",
  "version": "0.1.0",
  "private": true,
  "description": "Virtual riders/drivers exercising the real backend (simulator plan Phase 1)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"*.json\"",
    "test": "vitest run",
    "sim": "tsx src/index.ts"
  },
  "dependencies": {
    "@hailing/constants": "workspace:*",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
