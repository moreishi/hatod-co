{
  "name": "@hailing/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Hailing background worker — notifications, dispatch jobs (spec §14)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"*.json\"",
    "test": "vitest run",
    "prisma:generate": "prisma generate --schema ../api/prisma/schema.prisma"
  },
  "dependencies": {
    "@hailing/constants": "workspace:*",
    "@hailing/notifications": "workspace:*",
    "@prisma/client": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prisma": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
